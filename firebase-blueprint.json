{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role-based access control (normal, premium, admin)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["normal", "premium", "admin"] },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "generationCount": { "type": "number" },
        "dailyGenerations": { "type": "number" },
        "lastGenerationDate": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Generation": {
      "title": "Speech Generation Record",
      "description": "History of TTS speech generated by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "text": { "type": "string" },
        "voice": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "text", "voice"]
    },
    "UpgradeRequest": {
      "title": "Premium Upgrade Request",
      "description": "User requests for upgrading to Premium tier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "plan": { "type": "string" },
        "paymentSlipBase64": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection indexed by Firebase Auth UID"
    },
    "/generations/{generationId}": {
      "schema": { "$ref": "#/entities/Generation" },
      "description": "TTS generation logs"
    },
    "/upgrade_requests/{requestId}": {
      "schema": { "$ref": "#/entities/UpgradeRequest" },
      "description": "Requests from normal users to upgrade to premium"
    }
  }
}
